// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
    // Further reading:
    // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
    // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
    url      = env("DATABASE_URL")
}

model Post {
    id        Int      @id @default(autoincrement())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    createdBy   User   @relation(fields: [createdById], references: [id])
    createdById String

    @@index([name])
}

model Store {
    id          String   @id @default(cuid())
    slug        String   @unique
    name        String
    handle      String
    bio         String   @default("")
    followers   String   @default("0")
    following   Int      @default(0)
    payoutName  String   @default("")
    payoutClabe String   @default("")
    ownerId     String?  @unique
    owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
    mixes       Mix[]
    orders      Order[]
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model Mix {
    id          String   @id @default(cuid())
    slug        String   @unique
    name        String
    kind        String
    price       String
    image       String   @default("")
    description String   @default("")
    ingredients Json
    preparation Json
    tags        Json
    available   Boolean  @default(true)
    house       Boolean  @default(false)
    position    Int
    storeId     String
    store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
    authorId    String?
    author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([storeId])
    @@index([authorId])
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? // @db.Text
    access_token             String? // @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? // @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    passwordHash  String?
    isStore       Boolean   @default(false)
    accounts      Account[]
    sessions      Session[]
    posts         Post[]
    store         Store?
    authoredMixes Mix[]
    orders        Order[]
}

/// Checkout order backed by a Pey transaction (CoDi QR / push / payment link).
model Order {
    id               String    @id @default(cuid())
    /// Pey transaction ULID when known (set once paid / push created).
    peyTransactionId String?   @unique
    status           String    @default("PENDING")
    amount           Float
    amountBase       Float?
    amountTip        Float?
    amountFee        Float?
    currency         String    @default("MXN")
    paymentMethod    String?
    payableType      String?
    payableId        String?
    description      String    @default("")
    trackingKey      String?
    numRef           String?
    /// Cart lines: [{ slug, name, price, quantity }]
    items            Json
    metadata         Json?
    raw              Json?
    /// Store the buyer purchased from (relation + snapshot for history).
    storeId          String
    store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
    storeSlug        String
    storeName        String
    storeHandle      String    @default("")
    userId           String
    user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    paidAt           DateTime?
    peyCreatedAt     DateTime?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt

    @@index([storeId])
    @@index([storeSlug])
    @@index([userId])
    @@index([status])
    @@index([numRef])
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}
